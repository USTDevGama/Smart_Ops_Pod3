# Copy to .env for local work. Never commit .env or real keys.
PODC_ENV=local
PODC_DATABASE_URL=postgresql+psycopg://podc:podc@localhost:5432/podc
PODC_REDIS_URL=redis://localhost:6379/0
PODC_CELERY_BROKER_URL=redis://localhost:6379/1
PODC_BLOB_DIR=./storage
# "fake" runs everything against FakeLLM (no key needed). A real provider arrives with the API keys.
PODC_LLM_PROVIDER=fake
PODC_RETENTION_DAYS=30
PODC_MAX_LLM_CALLS_PER_SESSION=40
# Dev-only fake login (X-Dev-User / X-Dev-Role headers). The app refuses to start with this on outside local/dev.
PODC_DEV_AUTH_ENABLED=true
# Optional: folder with the program's confidential seed pack (kept OUTSIDE this repo).
# Enables tests/test_seed_pack.py and app/seed.py. Leave empty if you do not have it.
# PODC_SEED_DIR=C:/path/to/Team_C_Seed_Data
