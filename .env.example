# Copy to .env for local work. Never commit .env or real keys.
PODC_ENV=local
PODC_DATABASE_URL=postgresql+psycopg://podc:podc@localhost:5432/podc
PODC_REDIS_URL=redis://localhost:6379/0
PODC_CELERY_BROKER_URL=redis://localhost:6379/1
PODC_BLOB_DIR=./storage
PODC_MAX_UPLOAD_MB=10
# true = run profile ingest inside the API call, so you need no Redis or worker locally
PODC_INGEST_INLINE=true
# "fake" runs everything against FakeLLM (no key needed). Any other value (e.g. "anthropic") uses
# the real Claude client below.
PODC_LLM_PROVIDER=fake
# Real model: the key below is needed for all three shapes, however your org makes you fetch it
# (vault, portal, etc.) - never commit the real value. Then pick ONE shape:
# PODC_ANTHROPIC_API_KEY=
# 1) Direct Anthropic API: just MODEL, leave USE_AZURE/GATEWAY_URL unset.
# PODC_ANTHROPIC_MODEL=claude-sonnet-5
# 2) Claude on Azure AI Foundry (its own client/API shape):
# PODC_ANTHROPIC_USE_AZURE=true
# PODC_ANTHROPIC_AZURE_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic/
# PODC_ANTHROPIC_AZURE_DEPLOYMENT=claude-sonnet-5
# 3) An internal Anthropic-compatible gateway (e.g. an LLM proxy): wins over USE_AZURE if both are
# set. MODEL is whatever model/deployment id the gateway expects.
# PODC_ANTHROPIC_GATEWAY_URL=https://<your-gateway-host>/
# PODC_ANTHROPIC_MODEL=<gateway-model-id>
# Instead of a direct key, the key can come from Azure Key Vault at call time (a direct
# PODC_ANTHROPIC_API_KEY above still wins if both are set). All five below are required together.
# The real values belong in the server's own .env, never in the repo or in this file.
# PODC_AZURE_VAULT_URL=https://<your-vault>.vault.azure.net
# PODC_AZURE_VAULT_SECRET_NAME=<secret-name>
# PODC_AZURE_TENANT_ID=<tenant-id>
# PODC_AZURE_CLIENT_ID=<app-registration-client-id>
# PODC_AZURE_CLIENT_SECRET=<app-registration-client-secret>
# If this machine cannot reach the model directly (a network-proxy block), route the call
# through a local SOCKS proxy instead - typically the near end of an SSH dynamic-forward tunnel
# to a host that *can* reach it:
#   ssh -D 1080 -N <user>@<jump-host>          (or: plink -D 1080 -N <user>@<jump-host>)
# then point the app at it (restart after changing this):
# PODC_ANTHROPIC_PROXY_URL=socks5h://127.0.0.1:1080
PODC_RETENTION_DAYS=30
# Dev-only fake login (X-Dev-User / X-Dev-Role headers). The app refuses to start with this on outside local/dev.
PODC_DEV_AUTH_ENABLED=true
# Optional: folder with the program's confidential seed pack (kept OUTSIDE this repo).
# Enables tests/test_seed_pack.py and app/seed.py. Leave empty if you do not have it.
# PODC_SEED_DIR=C:/path/to/Team_C_Seed_Data
