# Deployment
UI_PORT=8090

# Application environment
PODC_ENV=prod
PODC_DEV_AUTH_ENABLED=false
PODC_INGEST_INLINE=false

# Shared PostgreSQL
# Replace the placeholder password in the real server-side .env only.
PODC_DATABASE_URL=postgresql+psycopg://podc:CHANGE_ME@shared-postgres:5432/podc

# Shared Redis
PODC_REDIS_URL=redis://shared-redis:6379/0
PODC_CELERY_BROKER_URL=redis://shared-redis:6379/1

# Persistent Docker storage
PODC_BLOB_DIR=/app/storage
PODC_MAX_UPLOAD_MB=10
PODC_RETENTION_DAYS=30

# LLM
PODC_LLM_PROVIDER=anthropic
PODC_ANTHROPIC_API_KEY=CHANGE_ME
PODC_ANTHROPIC_MODEL=CHANGE_ME

# Use whichever LLM routing mode applies in the deployed environment.
PODC_ANTHROPIC_GATEWAY_URL=
PODC_ANTHROPIC_USE_AZURE=false
PODC_ANTHROPIC_AZURE_ENDPOINT=
PODC_ANTHROPIC_AZURE_DEPLOYMENT=
PODC_ANTHROPIC_TIMEOUT_S=30

# Confidential seed pack location, if required.
PODC_SEED_DIR=