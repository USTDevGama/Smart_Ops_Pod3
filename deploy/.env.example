# Backend deployment: the API and the Celery worker. The deploy workflow writes the real .env on
# the server (in the deploy folder, mode 600) from GitHub Actions secrets and variables. Never put
# a real password or key in this file or anywhere in git.

# Application environment
PODC_ENV=prod
PODC_DEV_AUTH_ENABLED=false
PODC_INGEST_INLINE=false
PODC_LOG_LEVEL=INFO

# Shared PostgreSQL (database and role "podc" already exist). The password comes from the
# GitHub secret PODC_DATABASE_URL.
PODC_DATABASE_URL=postgresql+psycopg://podc:CHANGE_ME@shared-postgres:5432/podc

# Trainee profiles, read from Pod D's database (schema trainee_profiles). Placeholder only: the real
# URL carries a password, so it belongs in a GitHub secret (TRAINEE_DB_URL), never in git. Note the
# name has no PODC_ prefix, so Settings does not read it yet and the deploy workflow does not write
# it into .env yet: both are still to be added when the code that uses it lands. Ask Pod D for a
# read-only role limited to that schema rather than using their owner role.
# TRAINEE_DB_URL=postgresql+psycopg://<user>:CHANGE_ME@shared-postgres:5432/pod_d?options=-csearch_path%3Dtrainee_profiles

# Shared Redis
# Other pods may use this Redis too. Before the first deploy check these database numbers are free:
#   docker exec shared-redis redis-cli INFO keyspace
PODC_REDIS_URL=redis://shared-redis:6379/0
PODC_CELERY_BROKER_URL=redis://shared-redis:6379/1

# Persistent Docker storage
PODC_BLOB_DIR=/app/storage
PODC_MAX_UPLOAD_MB=10
PODC_RETENTION_DAYS=30

# LLM
PODC_LLM_PROVIDER=anthropic
PODC_ANTHROPIC_MODEL=CHANGE_ME

# Where the model key comes from. The deploy workflow writes ONE of these two, never both:
#
# 1) Key Vault mode (preferred): the app fetches the key from the vault itself, and fetches it again
#    when the gateway rejects it, so a rotated key needs no redeploy. All five are needed
#    (variables PODC_AZURE_VAULT_URL, ..._SECRET_NAME, ..._TENANT_ID, ..._CLIENT_ID and the
#    secret PODC_AZURE_CLIENT_SECRET). Leave PODC_ANTHROPIC_API_KEY out completely: a fixed key
#    always beats the vault, and a blank line is read as "not set".
# PODC_AZURE_VAULT_URL=https://<your-vault>.vault.azure.net
# PODC_AZURE_VAULT_SECRET_NAME=<secret-name>
# PODC_AZURE_TENANT_ID=<tenant-id>
# PODC_AZURE_CLIENT_ID=<app-registration-client-id>
# PODC_AZURE_CLIENT_SECRET=CHANGE_ME
#
# 2) Fixed key (used when none of the five are set): copied from the GitHub secret
#    PODC_ANTHROPIC_API_KEY. It goes stale when the key is rotated.
PODC_ANTHROPIC_API_KEY=CHANGE_ME

# Use whichever LLM routing mode applies in the deployed environment.
PODC_ANTHROPIC_GATEWAY_URL=
PODC_ANTHROPIC_USE_AZURE=false
PODC_ANTHROPIC_AZURE_ENDPOINT=
PODC_ANTHROPIC_AZURE_DEPLOYMENT=
PODC_ANTHROPIC_TIMEOUT_S=30

# How to turn thinking off. Claude Sonnet 5.5 rejects "disabled" and needs "between_tools"; most
# other Claude models accept "disabled". Match the model above.
PODC_ANTHROPIC_THINKING_OFF=between_tools

# Confidential seed pack location, if required.
PODC_SEED_DIR=
